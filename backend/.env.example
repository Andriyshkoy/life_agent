LIFE_AGENT_ENVIRONMENT=development
LIFE_AGENT_DATABASE_URL=postgresql+asyncpg://life_agent:replace-me@postgres:5432/life_agent
LIFE_AGENT_ACCESS_TOKEN_HMAC_KEY=replace-with-an-independent-32-byte-base64url-key
LIFE_AGENT_REFRESH_TOKEN_HMAC_KEY=replace-with-an-independent-32-byte-base64url-key
LIFE_AGENT_ENROLLMENT_CODE_HMAC_KEY=replace-with-an-independent-32-byte-base64url-key
LIFE_AGENT_CURSOR_HMAC_KEY=replace-with-an-independent-32-byte-base64url-key
LIFE_AGENT_LOG_LEVEL=INFO
LIFE_AGENT_DB_POOL_SIZE=5
LIFE_AGENT_DB_MAX_OVERFLOW=5
LIFE_AGENT_DB_POOL_RECYCLE_SECONDS=1800
LIFE_AGENT_READINESS_TIMEOUT_SECONDS=2.0
