LIFE_AGENT_API_LOOPBACK_PORT=18080
LIFE_AGENT_LOG_LEVEL=INFO
LIFE_AGENT_DB_POOL_SIZE=5
LIFE_AGENT_DB_MAX_OVERFLOW=5
LIFE_AGENT_DB_POOL_RECYCLE_SECONDS=1800
LIFE_AGENT_READINESS_TIMEOUT_SECONDS=2.0
LIFE_AGENT_ACCESS_TOKEN_HMAC_KEY_GENERATION=1
LIFE_AGENT_REFRESH_TOKEN_HMAC_KEY_GENERATION=1
LIFE_AGENT_ENROLLMENT_CODE_HMAC_KEY_GENERATION=1
LIFE_AGENT_REPLAY_FINGERPRINT_HMAC_KEY_GENERATION=1
LIFE_AGENT_REPLAY_RESPONSE_ENCRYPTION_KEY_GENERATION=1
LIFE_AGENT_CURSOR_HMAC_KEY_GENERATION=1
LIFE_AGENT_POSTGRES_OWNER_PASSWORD_SECRET_FILE=/etc/life-agent/credentials/postgres-owner-password
LIFE_AGENT_POSTGRES_RUNTIME_PASSWORD_SECRET_FILE=/etc/life-agent/credentials/postgres-runtime-password
LIFE_AGENT_MIGRATION_DATABASE_URL_SECRET_FILE=/etc/life-agent/credentials/migration-database-url
LIFE_AGENT_RUNTIME_DATABASE_URL_SECRET_FILE=/etc/life-agent/credentials/runtime-database-url
LIFE_AGENT_ACCESS_TOKEN_HMAC_KEY_SECRET_FILE=/etc/life-agent/credentials/access-token-hmac-key
LIFE_AGENT_REFRESH_TOKEN_HMAC_KEY_SECRET_FILE=/etc/life-agent/credentials/refresh-token-hmac-key
LIFE_AGENT_ENROLLMENT_CODE_HMAC_KEY_SECRET_FILE=/etc/life-agent/credentials/enrollment-code-hmac-key
LIFE_AGENT_REPLAY_FINGERPRINT_HMAC_KEY_SECRET_FILE=/etc/life-agent/credentials/replay-fingerprint-hmac-key
LIFE_AGENT_REPLAY_RESPONSE_ENCRYPTION_KEY_SECRET_FILE=/etc/life-agent/credentials/replay-response-encryption-key
LIFE_AGENT_CURSOR_HMAC_KEY_SECRET_FILE=/etc/life-agent/credentials/cursor-hmac-key
