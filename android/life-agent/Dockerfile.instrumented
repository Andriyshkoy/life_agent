FROM life-agent-product-builder:ci

USER root

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        libasound2 \
        libdbus-1-3 \
        libfontconfig1 \
        libgl1 \
        libnss3 \
        libpulse0 \
        libx11-6 \
        libx11-xcb1 \
        libxcb1 \
        libxcomposite1 \
        libxcursor1 \
        libxdamage1 \
        libxfixes3 \
        libxi6 \
        libxkbfile1 \
        libxrandr2 \
        libxtst6 \
    && rm -rf /var/lib/apt/lists/*

RUN sdk_attempt=1 \
    && until sdkmanager --sdk_root="${ANDROID_HOME}" \
            "emulator" \
            "platforms;android-35" \
            "system-images;android-35;aosp_atd;x86_64"; do \
        if [ "${sdk_attempt}" -ge 3 ]; then \
            exit 1; \
        fi; \
        sdk_attempt=$((sdk_attempt + 1)); \
    done \
    && chown -R gradle:gradle "${ANDROID_HOME}"

ENV PATH="${ANDROID_HOME}/emulator:${PATH}"

USER gradle
WORKDIR /workspace

CMD ["./gradlew", "--no-daemon", "--stacktrace", ":app:localApi35DebugAndroidTest"]
