{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-agent.local/schemas/extraction.schema.json",
  "title": "Life Agent voice extraction envelope",
  "description": "Post-MVP ASR candidate-fact result with reproducible processing metadata, deterministic time resolution, closed per-kind payloads and evidence links. Candidate kinds/statuses are deliberately broader than the current canonical life-event v4 contract and cannot be persisted there without confirmation plus a supported mapping/schema version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_id",
    "created_at",
    "source",
    "reproducibility",
    "asr",
    "facts",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "const": "3.0.0"
    },
    "extraction_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "reproducibility": {
      "$ref": "#/$defs/reproducibility"
    },
    "asr": {
      "$ref": "#/$defs/asr"
    },
    "facts": {
      "type": "array",
      "description": "Empty when ASR failed or the transcript contains no supported facts; the extractor must never invent a placeholder fact.",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "validation": {
      "$ref": "#/$defs/validation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "asr": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "asr"
        ]
      },
      "then": {
        "properties": {
          "facts": {
            "maxItems": 0
          },
          "validation": {
            "properties": {
              "state": {
                "const": "rejected"
              },
              "errors": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation": {
            "properties": {
              "state": {
                "const": "accepted"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "validation"
        ]
      },
      "then": {
        "properties": {
          "facts": {
            "not": {
              "contains": {
                "properties": {
                  "requires_confirmation": {
                    "const": true
                  }
                },
                "required": [
                  "requires_confirmation"
                ]
              }
            }
          },
          "validation": {
            "properties": {
              "schema_valid": {
                "const": true
              },
              "evidence_valid": {
                "const": true
              },
              "semantic_checks_passed": {
                "const": true
              },
              "validated_at": {
                "type": "string",
                "format": "date-time"
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation": {
            "properties": {
              "state": {
                "const": "needs_confirmation"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "validation"
        ]
      },
      "then": {
        "properties": {
          "facts": {
            "contains": {
              "properties": {
                "requires_confirmation": {
                  "const": true
                }
              },
              "required": [
                "requires_confirmation"
              ]
            }
          },
          "validation": {
            "properties": {
              "schema_valid": {
                "const": true
              },
              "evidence_valid": {
                "const": true
              },
              "semantic_checks_passed": {
                "const": true
              },
              "validated_at": {
                "type": "string",
                "format": "date-time"
              },
              "errors": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "validation": {
            "properties": {
              "state": {
                "const": "rejected"
              }
            },
            "required": [
              "state"
            ]
          }
        },
        "required": [
          "validation"
        ]
      },
      "then": {
        "properties": {
          "validation": {
            "properties": {
              "errors": {
                "minItems": 1
              },
              "validated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nullableDateTime": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableConfidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "input_type",
        "capture_id",
        "local_artifact_id",
        "recorded_at",
        "received_at",
        "temporal_basis_at",
        "timezone",
        "utc_offset_minutes",
        "audio_duration_ms",
        "audio_mime_type",
        "audio_sha256"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "android_recording",
            "android_share_intent",
            "file_import"
          ]
        },
        "input_type": {
          "type": "string",
          "enum": [
            "voice",
            "audio"
          ]
        },
        "capture_id": {
          "type": "string",
          "format": "uuid",
          "description": "Stable Life Agent capture identifier created on the Android device."
        },
        "local_artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "temporal_basis_at": {
          "type": "string",
          "format": "date-time",
          "description": "Immutable instant used as the sole anchor for resolving relative expressions; recorded_at when known, otherwise received_at."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "description": "IANA timezone used by the versioned temporal resolver."
        },
        "utc_offset_minutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
      "audio_duration_ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7200000
        },
        "audio_mime_type": {
          "type": "string",
          "pattern": "^audio/[A-Za-z0-9!#$&^_.+-]+$"
        },
        "audio_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_version",
        "runtime",
        "asr",
        "extractor",
        "temporal_resolver"
      ],
      "properties": {
        "pipeline_version": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "version",
            "platform"
          ],
          "properties": {
            "implementation": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "platform": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "asr": {
          "$ref": "#/$defs/componentFingerprint"
        },
        "extractor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "engine",
            "model",
            "model_version",
            "config_sha256",
            "prompt_version"
          ],
          "properties": {
            "engine": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "model_version": {
              "type": "string",
              "minLength": 1
            },
            "config_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "temporal_resolver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version",
            "ruleset_sha256"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "ruleset_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "componentFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "model",
        "model_version",
        "config_sha256"
      ],
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "config_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "asr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "engine",
        "model",
        "model_version",
        "language",
        "transcript",
        "confidence",
        "segments",
        "warnings"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "partial",
            "failed"
          ]
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_version": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})?$"
        },
        "transcript": {
          "type": "string",
          "description": "Immutable normalized ASR transcript used by all evidence character offsets."
        },
        "confidence": {
          "$ref": "#/$defs/nullableConfidence"
        },
        "segments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asrSegment"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "language": {
                "type": "null"
              },
              "transcript": {
                "const": ""
              },
              "confidence": {
                "type": "null"
              },
              "segments": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "language": {
                "type": "string"
              },
              "transcript": {
                "type": "string",
                "minLength": 1
              },
              "segments": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "asrSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "start_ms",
        "end_ms",
        "transcript_start",
        "transcript_end",
        "text",
        "confidence"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
      "end_ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7200000,
          "description": "Exclusive audio offset; semantic validation ensures end_ms is greater than start_ms."
        },
        "transcript_start": {
          "type": "integer",
          "minimum": 0,
          "description": "Inclusive Unicode code-point offset in asr.transcript."
        },
        "transcript_end": {
          "type": "integer",
          "minimum": 1,
          "description": "Exclusive Unicode code-point offset in asr.transcript."
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "$ref": "#/$defs/nullableConfidence"
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "kind",
        "status",
        "occurred_at",
        "time_precision",
        "time_expression",
        "resolved_time",
        "payload",
        "evidence",
        "ambiguities",
        "extraction_confidence",
        "requires_confirmation"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "format": "uuid"
        },
        "kind": {
          "$ref": "event-payloads.schema.json#/$defs/kind"
        },
        "status": {
          "type": "string",
          "enum": [
            "observed",
            "planned",
            "negated",
            "uncertain"
          ]
        },
        "occurred_at": {
          "$ref": "#/$defs/nullableDateTime",
          "description": "Normalized event instant only when supported by the words and resolution rules; never inferred merely to make the field non-null."
        },
        "time_precision": {
          "type": "string",
          "enum": [
            "exact",
            "approximate",
            "date",
            "part_of_day",
            "unknown"
          ]
        },
        "time_expression": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "Original temporal wording, preserved verbatim; null when absent."
        },
        "resolved_time": {
          "$ref": "#/$defs/resolvedTime"
        },
        "payload": {
          "$ref": "event-payloads.schema.json#/$defs/payload"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidenceSpan"
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ambiguity"
          }
        },
        "extraction_confidence": {
          "$ref": "#/$defs/nullableConfidence",
          "description": "Extractor routing signal, not a calibrated probability of truth."
        },
        "requires_confirmation": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "time_precision": {
                "const": "exact"
              }
            },
            "required": [
              "time_precision"
            ]
          },
          "then": {
            "properties": {
              "occurred_at": {
                "type": "string",
                "format": "date-time"
              },
              "time_expression": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "time_precision": {
                "const": "unknown"
              }
            },
            "required": [
              "time_precision"
            ]
          },
          "then": {
            "properties": {
              "occurred_at": {
                "type": "null"
              },
              "time_expression": {
                "type": "null"
              },
              "resolved_time": {
                "properties": {
                  "resolution_source": {
                    "const": "recording_fallback"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "time_expression": {
                "type": "null"
              }
            },
            "required": [
              "time_expression"
            ]
          },
          "then": {
            "properties": {
              "resolved_time": {
                "properties": {
                  "resolution_source": {
                    "const": "recording_fallback"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "resolved_time": {
                "properties": {
                  "resolution_source": {
                    "enum": [
                      "explicit_expression",
                      "relative_expression"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "ambiguities": {
                "minItems": 1
              }
            },
            "required": [
              "ambiguities"
            ]
          },
          "then": {
            "properties": {
              "requires_confirmation": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "medication_intake",
                  "supplement_intake"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "requires_confirmation": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wellbeing"
              },
              "payload": {
                "properties": {
                  "scale_source": {
                    "const": "configured"
                  }
                },
                "required": [
                  "scale_source"
                ]
              }
            },
            "required": [
              "kind",
              "payload"
            ]
          },
          "then": {
            "properties": {
              "requires_confirmation": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "symptom"
              },
              "payload": {
                "properties": {
                  "severity_scale_source": {
                    "const": "configured"
                  }
                },
                "required": [
                  "severity_scale_source"
                ]
              }
            },
            "required": [
              "kind",
              "payload"
            ]
          },
          "then": {
            "properties": {
              "requires_confirmation": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "meal"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "event-payloads.schema.json#/$defs/meal"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sleep"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "event-payloads.schema.json#/$defs/sleep"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wellbeing"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "event-payloads.schema.json#/$defs/wellbeing"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "workout"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "event-payloads.schema.json#/$defs/workout"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "symptom"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "event-payloads.schema.json#/$defs/symptom"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "medication_intake"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "event-payloads.schema.json#/$defs/medication_intake"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "supplement_intake"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "event-payloads.schema.json#/$defs/supplement_intake"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "measurement"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "event-payloads.schema.json#/$defs/measurement"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "routine"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "event-payloads.schema.json#/$defs/routine"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "note"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "event-payloads.schema.json#/$defs/note"
              }
            }
          }
        }
      ]
    },
    "resolvedTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis_at",
        "timezone",
        "utc_offset_minutes",
        "local_date",
        "interval_start_utc",
        "interval_end_utc",
        "resolution_source",
        "resolver_version"
      ],
      "properties": {
        "basis_at": {
          "type": "string",
          "format": "date-time",
          "description": "Must equal source.temporal_basis_at; checked by semantic validation."
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "description": "Must equal source.timezone; checked by semantic validation."
        },
        "utc_offset_minutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "local_date": {
          "type": "string",
          "format": "date"
        },
        "interval_start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "interval_end_utc": {
          "type": "string",
          "format": "date-time",
          "description": "Exclusive interval end; semantic validation ensures it is after interval_start_utc."
        },
        "resolution_source": {
          "type": "string",
          "enum": [
            "explicit_expression",
            "relative_expression",
            "recording_fallback"
          ]
        },
        "resolver_version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidenceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_paths",
        "quote",
        "transcript_start",
        "transcript_end",
        "audio_start_ms",
        "audio_end_ms",
        "asr_confidence"
      ],
      "properties": {
        "field_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/payload(?:/(?:[^~/]|~0|~1)*)*$"
          },
          "description": "Payload JSON Pointers directly supported by this evidence span."
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "transcript_start": {
          "type": "integer",
          "minimum": 0,
          "description": "Inclusive Unicode code-point offset in asr.transcript."
        },
        "transcript_end": {
          "type": "integer",
          "minimum": 1,
          "description": "Exclusive Unicode code-point offset; semantic validation verifies quote equals transcript[start:end]."
        },
        "audio_start_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "audio_end_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 7200000
        },
        "asr_confidence": {
          "$ref": "#/$defs/nullableConfidence"
        }
      },
      "oneOf": [
        {
          "properties": {
            "audio_start_ms": {
              "type": "integer"
            },
            "audio_end_ms": {
              "type": "integer"
            }
          }
        },
        {
          "properties": {
            "audio_start_ms": {
              "type": "null"
            },
            "audio_end_ms": {
              "type": "null"
            }
          }
        }
      ]
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field_path",
        "reason",
        "candidates",
        "question"
      ],
      "properties": {
        "field_path": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$",
          "description": "JSON Pointer relative to payload; null when the ambiguity affects the whole fact."
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        "question": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "schema_valid",
        "evidence_valid",
        "semantic_checks_passed",
        "validated_at",
        "warnings",
        "errors"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "accepted",
            "needs_confirmation",
            "rejected"
          ]
        },
        "schema_valid": {
          "type": "boolean"
        },
        "evidence_valid": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "semantic_checks_passed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "validated_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "warnings": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/validationIssue"
              },
              {
                "properties": {
                  "severity": {
                    "const": "warning"
                  }
                }
              }
            ]
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/validationIssue"
              },
              {
                "properties": {
                  "severity": {
                    "const": "error"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "validationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "fact_id",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "fact_id": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "jsonValue": {
      "description": "Arbitrary JSON value allowed only for ambiguity candidates, never as an event payload.",
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}
