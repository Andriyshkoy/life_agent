{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-agent.local/schemas/capture-envelope.schema.json",
  "title": "Life Agent local-first capture envelope",
  "description": "Immutable on-device capture provenance. installation_id and local_owner_id form an opaque local namespace; person_id, subject_id and remote identity fields are forbidden by the closed shape.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capture_id",
    "operation_id",
    "identity",
    "source",
    "content",
    "integrity"
  ],
  "properties": {
    "schema_version": {
      "const": "5.0.0"
    },
    "capture_id": {
      "$ref": "#/$defs/canonicalUuid",
      "description": "Stable identifier for the immutable local source capture."
    },
    "operation_id": {
      "$ref": "#/$defs/canonicalUuid",
      "description": "Stable local mutation identifier used for idempotent replay after process restoration."
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installation_id",
        "local_owner_id"
      ],
      "properties": {
        "installation_id": {
          "$ref": "#/$defs/canonicalUuid",
          "description": "Opaque identifier for this app installation."
        },
        "local_owner_id": {
          "$ref": "#/$defs/canonicalUuid",
          "description": "Opaque single-owner namespace within this installation."
        }
      }
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "content": {
      "$ref": "#/$defs/structuredContent"
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "byte_size"
      ],
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256Digest"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912,
          "description": "Absolute local contract safety bound. A concrete importer may enforce a smaller limit."
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "channel": {
                "const": "health_connect"
              }
            },
            "required": [
              "channel"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/structuredContent"
          },
          "source": {
            "properties": {
              "origin": {
                "properties": {
                  "source_record_id": {
                    "type": "string"
                  },
                  "source_record_version": {
                    "type": "string"
                  },
                  "user_entered": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "channel": {
                "const": "connector"
              }
            },
            "required": [
              "channel"
            ]
          }
        },
        "required": [
          "source"
        ]
      },
      "then": {
        "properties": {
          "content": {
            "$ref": "#/$defs/structuredContent"
          },
          "source": {
            "properties": {
              "origin": {
                "properties": {
                  "source_record_id": {
                    "type": "string"
                  },
                  "user_entered": {
                    "const": false
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "canonicalUuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "description": "Canonical lowercase RFC 9562 UUID text. Uppercase, braces, URNs and trailing characters are forbidden."
    },
    "canonicalDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{3})?(?:Z|[+-](?!00:00)(?:(?:0[0-9]|1[0-3]):[0-5][0-9]|14:00))(?![\\s\\S])",
      "description": "Canonical RFC 3339 instant: uppercase T and Z, seconds required, no leap second, optional fractional part of exactly three digits, and either Z or a non-zero offset within ±14:00."
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "description": "Exactly 32 SHA-256 bytes encoded as 64 lowercase hexadecimal characters."
    },
    "nullableText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "recorded_at",
        "timezone_id",
        "utc_offset_minutes",
        "origin",
        "collector"
      ],
      "properties": {
        "channel": {
          "type": "string",
          "enum": [
            "android_manual",
            "health_connect",
            "connector",
            "system"
          ]
        },
        "recorded_at": {
          "$ref": "#/$defs/canonicalDateTime"
        },
        "timezone_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Recorded-time zone only: either canonical Z/±HH:MM fixed-offset text or an installed IANA zone. It is validated against source.recorded_at and is independent of an event's effective timezone."
        },
        "utc_offset_minutes": {
          "type": "integer",
          "minimum": -840,
          "maximum": 840
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "provider",
            "app",
            "device",
            "source_record_id",
            "source_record_version",
            "user_entered"
          ],
          "properties": {
            "provider": {
              "$ref": "#/$defs/nullableText"
            },
            "app": {
              "$ref": "#/$defs/nullableText"
            },
            "device": {
              "$ref": "#/$defs/nullableText"
            },
            "source_record_id": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "source_record_version": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "user_entered": {
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "source_record_version": {
                    "type": "string"
                  }
                },
                "required": [
                  "source_record_version"
                ]
              },
              "then": {
                "properties": {
                  "source_record_id": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source_record_id": {
                    "type": "null"
                  }
                },
                "required": [
                  "source_record_id"
                ]
              },
              "then": {
                "properties": {
                  "source_record_version": {
                    "type": "null"
                  }
                }
              }
            }
          ]
        },
        "collector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "structuredContent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "record_type",
        "payload"
      ],
      "properties": {
        "kind": {
          "const": "structured"
        },
        "record_type": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      }
    }
  }
}
