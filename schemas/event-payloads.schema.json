{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://life-agent.local/schemas/event-payloads.schema.json",
  "title": "Life Agent canonical local event payloads",
  "description": "Authoritative, closed payload contracts for persisted local event revisions. Catalog labels, doses and nutrient values are immutable snapshots: a later catalog edit creates a new catalog version and never rewrites an existing revision.",
  "$defs": {
    "kind": {
      "type": "string",
      "enum": [
        "meal",
        "sleep",
        "wellbeing",
        "medication_intake",
        "supplement_intake",
        "measurement",
        "note"
      ]
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "nullableUuid": {
      "oneOf": [
        {
          "$ref": "#/$defs/uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "nonNegativeDecimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
      "description": "Base-10 decimal encoded as a JSON string so nutrition and dose values never pass through binary floating point."
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^(?:0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(?:\\.[0-9]+)?)$"
    },
    "nullableNonNegativeDecimal": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonNegativeDecimal"
        },
        {
          "type": "null"
        }
      ]
    },
    "quantityUnit": {
      "type": "string",
      "enum": [
        "g",
        "ml",
        "piece",
        "serving"
      ]
    },
    "catalogVersionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_kind",
        "catalog_item_id",
        "catalog_version_id"
      ],
      "properties": {
        "catalog_kind": {
          "type": "string",
          "enum": [
            "food_product",
            "recipe"
          ]
        },
        "catalog_item_id": {
          "$ref": "#/$defs/uuid",
          "description": "Stable food_id or recipe_id."
        },
        "catalog_version_id": {
          "$ref": "#/$defs/uuid",
          "description": "Exact immutable product-card or recipe version used for the calculation."
        }
      }
    },
    "nutrientInputRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalog_kind",
        "catalog_item_id",
        "catalog_version_id"
      ],
      "properties": {
        "catalog_kind": {
          "type": "string",
          "enum": [
            "food_product",
            "recipe"
          ]
        },
        "catalog_item_id": {
          "$ref": "#/$defs/uuid"
        },
        "catalog_version_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "nutrientSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_schema",
        "basis_quantity",
        "basis_unit",
        "energy_kcal",
        "protein_g",
        "fat_g",
        "carbohydrate_g",
        "calculation_version",
        "input_refs"
      ],
      "properties": {
        "snapshot_schema": {
          "const": "nutrition-snapshot/1.0.0"
        },
        "basis_quantity": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "basis_unit": {
          "$ref": "#/$defs/quantityUnit"
        },
        "energy_kcal": {
          "$ref": "#/$defs/nullableNonNegativeDecimal"
        },
        "protein_g": {
          "$ref": "#/$defs/nullableNonNegativeDecimal"
        },
        "fat_g": {
          "$ref": "#/$defs/nullableNonNegativeDecimal"
        },
        "carbohydrate_g": {
          "$ref": "#/$defs/nullableNonNegativeDecimal"
        },
        "calculation_version": {
          "type": "string",
          "minLength": 1
        },
        "input_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nutrientInputRef"
          }
        }
      }
    },
    "mealItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumption_item_id",
        "catalog_ref",
        "name_snapshot",
        "portion_preset_id",
        "quantity",
        "unit",
        "nutrient_snapshot"
      ],
      "properties": {
        "consumption_item_id": {
          "$ref": "#/$defs/uuid"
        },
        "catalog_ref": {
          "$ref": "#/$defs/catalogVersionRef"
        },
        "name_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "portion_preset_id": {
          "$ref": "#/$defs/nullableUuid"
        },
        "quantity": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "unit": {
          "$ref": "#/$defs/quantityUnit"
        },
        "nutrient_snapshot": {
          "$ref": "#/$defs/nutrientSnapshot"
        }
      }
    },
    "meal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "meal_type",
        "items",
        "comment"
      ],
      "properties": {
        "meal_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "breakfast",
            "lunch",
            "dinner",
            "snack",
            "other",
            null
          ]
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/mealItem"
          }
        },
        "comment": {
          "$ref": "#/$defs/nullableText"
        }
      }
    },
    "wellbeingValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension_id",
        "dimension_version",
        "dimension_label_snapshot",
        "option_id",
        "option_version",
        "option_label_snapshot",
        "option_sort_order_snapshot"
      ],
      "properties": {
        "dimension_id": {
          "$ref": "#/$defs/uuid"
        },
        "dimension_version": {
          "type": "integer",
          "minimum": 1
        },
        "dimension_label_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "option_id": {
          "$ref": "#/$defs/uuid"
        },
        "option_version": {
          "type": "integer",
          "minimum": 1
        },
        "option_label_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "option_sort_order_snapshot": {
          "type": "integer"
        }
      }
    },
    "wellbeing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "comment"
      ],
      "properties": {
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/wellbeingValue"
          },
          "description": "The semantic validator rejects repeated dimension_id values; JSON Schema cannot express key-based uniqueness."
        },
        "comment": {
          "$ref": "#/$defs/nullableText"
        }
      }
    },
    "concentrationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "amount",
        "unit",
        "per_amount",
        "per_unit"
      ],
      "properties": {
        "amount": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "per_amount": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "per_unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "dosePresetSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dose_preset_id",
        "dose_preset_version",
        "label_snapshot"
      ],
      "properties": {
        "dose_preset_id": {
          "$ref": "#/$defs/uuid"
        },
        "dose_preset_version": {
          "type": "integer",
          "minimum": 1
        },
        "label_snapshot": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "item_version",
        "item_type",
        "name_snapshot",
        "form_snapshot",
        "concentration_snapshot",
        "dose_preset_snapshot",
        "dose",
        "comment"
      ],
      "properties": {
        "item_id": {
          "$ref": "#/$defs/uuid"
        },
        "item_version": {
          "type": "integer",
          "minimum": 1
        },
        "item_type": {
          "type": "string",
          "enum": [
            "medication",
            "supplement"
          ]
        },
        "name_snapshot": {
          "type": "string",
          "minLength": 1
        },
        "form_snapshot": {
          "$ref": "#/$defs/nullableText"
        },
        "concentration_snapshot": {
          "oneOf": [
            {
              "$ref": "#/$defs/concentrationSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "dose_preset_snapshot": {
          "oneOf": [
            {
              "$ref": "#/$defs/dosePresetSnapshot"
            },
            {
              "type": "null"
            }
          ]
        },
        "dose": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantity",
            "unit"
          ],
          "properties": {
            "quantity": {
              "$ref": "#/$defs/positiveDecimal"
            },
            "unit": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "comment": {
          "$ref": "#/$defs/nullableText"
        }
      }
    },
    "medication_intake": {
      "allOf": [
        {
          "$ref": "#/$defs/intake"
        },
        {
          "properties": {
            "item_type": {
              "const": "medication"
            }
          }
        }
      ]
    },
    "supplement_intake": {
      "allOf": [
        {
          "$ref": "#/$defs/intake"
        },
        {
          "properties": {
            "item_type": {
              "const": "supplement"
            }
          }
        }
      ]
    },
    "sourceRecordPair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_record_id",
        "source_record_version"
      ],
      "properties": {
        "source_record_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_record_version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source_record_version": {
                "type": "string"
              }
            },
            "required": [
              "source_record_version"
            ]
          },
          "then": {
            "properties": {
              "source_record_id": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source_record_id": {
                "type": "null"
              }
            },
            "required": [
              "source_record_id"
            ]
          },
          "then": {
            "properties": {
              "source_record_version": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "sleepStage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage_id",
        "stage",
        "start_utc",
        "end_utc",
        "source_record"
      ],
      "properties": {
        "stage_id": {
          "$ref": "#/$defs/uuid"
        },
        "stage": {
          "type": "string",
          "enum": [
            "unknown",
            "awake",
            "sleeping",
            "light",
            "deep",
            "rem",
            "out_of_bed"
          ]
        },
        "start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "end_utc": {
          "type": "string",
          "format": "date-time"
        },
        "source_record": {
          "$ref": "#/$defs/sourceRecordPair"
        }
      }
    },
    "sleep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session",
        "stages",
        "source_provenance"
      ],
      "properties": {
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start_utc",
            "end_utc",
            "duration_seconds"
          ],
          "properties": {
            "start_utc": {
              "type": "string",
              "format": "date-time"
            },
            "end_utc": {
              "type": "string",
              "format": "date-time"
            },
            "duration_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "stages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sleepStage"
          },
          "description": "May be empty when the source exposes only a session. The semantic validator checks order, non-overlap and containment."
        },
        "source_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source_app_package",
            "source_app_version",
            "device_manufacturer",
            "device_model",
            "recording_method",
            "source_modified_at"
          ],
          "properties": {
            "source_app_package": {
              "type": "string",
              "minLength": 1
            },
            "source_app_version": {
              "$ref": "#/$defs/nullableText"
            },
            "device_manufacturer": {
              "$ref": "#/$defs/nullableText"
            },
            "device_model": {
              "$ref": "#/$defs/nullableText"
            },
            "recording_method": {
              "type": "string",
              "enum": [
                "actively_recorded",
                "automatically_recorded",
                "manual_entry",
                "unknown"
              ]
            },
            "source_modified_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "raw_value",
        "raw_unit",
        "canonical_value",
        "ucum_code",
        "method",
        "body_site",
        "aggregation_period",
        "sample_index"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "enum": [
            "heart_rate",
            "resting_heart_rate"
          ]
        },
        "raw_value": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "raw_unit": {
          "const": "bpm"
        },
        "canonical_value": {
          "$ref": "#/$defs/positiveDecimal"
        },
        "ucum_code": {
          "const": "/min"
        },
        "method": {
          "$ref": "#/$defs/nullableText"
        },
        "body_site": {
          "$ref": "#/$defs/nullableText"
        },
        "aggregation_period": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "instant",
            "session",
            "daily",
            null
          ]
        },
        "sample_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Deterministic occurrence index within the source record for heart-rate samples."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "metric_id": {
                "const": "heart_rate"
              }
            },
            "required": [
              "metric_id"
            ]
          },
          "then": {
            "properties": {
              "sample_index": {
                "type": "integer"
              }
            }
          },
          "else": {
            "properties": {
              "sample_index": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50000
        }
      }
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/$defs/meal"
        },
        {
          "$ref": "#/$defs/sleep"
        },
        {
          "$ref": "#/$defs/wellbeing"
        },
        {
          "$ref": "#/$defs/medication_intake"
        },
        {
          "$ref": "#/$defs/supplement_intake"
        },
        {
          "$ref": "#/$defs/measurement"
        },
        {
          "$ref": "#/$defs/note"
        }
      ]
    }
  },
  "$ref": "#/$defs/payload"
}
